Options -Indexes -MultiViews
ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest
AddType text/plain .txt
RewriteEngine On

# Configuration and bundled PHP dependencies must never be served as files.
<FilesMatch "^(?:config(?:\.local)?\.php|.*\.example)$">
  Require all denied
</FilesMatch>
RewriteRule ^assets/mail/vendor(?:/|$) - [F,L,NC]
RewriteRule ^assets/mail/email-templates\.php$ - [F,L,NC]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
RewriteRule \.(?:bak|orig|save|tmp|log|sql)$ - [F,L,NC]

# One public origin for all pages and assets.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.nikkiadvisory\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://nikkiadvisory.com%{REQUEST_URI} [R=301,L,NE]

# Keep unpublished source and backup files out of the public site.
RewriteRule ^(?:legacy-next-export|tools)(?:/|$) - [R=404,L,NC]
RewriteRule ^index\ copy\.html$ - [R=404,L,NC]
RewriteRule ^README\.md$ - [R=404,L,NC]

# HTML must revalidate; only content-versioned CSS/JS may be cached immutably.
RewriteCond %{QUERY_STRING} (^|&)v=[0-9a-f]{12}(&|$)
RewriteRule \.(?:css|js)$ - [E=NIKKI_VERSIONED_ASSET:1]
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?|txt|xml|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=604800"
    Header set Cache-Control "public, max-age=31536000, immutable" env=NIKKI_VERSIONED_ASSET
  </FilesMatch>
  <FilesMatch "\.(?:woff2?|png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
  <Files "404.html">
    Header always set X-Robots-Tag "noindex, follow"
  </Files>
</IfModule>
<IfModule mod_filter.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml text/xml image/svg+xml application/manifest+json
  </IfModule>
</IfModule>

# Compatibility URLs for reorganized static assets.
RewriteRule ^assets/js/COUNTRY_CODES_SOURCE\.md$ /assets/js/data/COUNTRY_CODES_SOURCE.md [R=301,L,NE]
RewriteRule ^assets/imgs/banners/about\-about\-breadcrumb\-advisory\-office\-v2-(960|1600|2164|mobile\-640|mobile\-960)\.webp$ /assets/images/about/office-banner-$1.webp [R=301,L,NE]
