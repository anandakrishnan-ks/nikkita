RewriteRule ^assets/imgs/services/corporate\-compliance\-card\.jpg$ /assets/images/services/corporate-compliance/card.jpg [R=301,L,NE]
RewriteRule ^assets/imgs/services/pro\-services\-card\.jpg$ /assets/images/services/pro-services/card.jpg [R=301,L,NE]
RewriteRule ^assets/imgs/sharjah\-mainland/sharjah\-2\.jpg$ /assets/images/shared/photography/business-planning.jpg [R=301,L,NE]
RewriteRule ^assets/imgs/sharjah\-mainland/sharjah\-waterfront\-real\.jpeg$ /assets/images/locations/uae/sharjah-mainland/waterfront.jpeg [R=301,L,NE]
RewriteRule ^assets/css/(aos\.css|bootstrap\.min\.css|line\-awesome\.min\.css|swiper\.min\.css)$ /assets/css/vendor/$1 [R=301,L,NE]
RewriteRule ^assets/imgs/(gold\-cursor\.svg|star\-shape\.svg)$ /assets/icons/ui/$1 [R=301,L,NE]
RewriteRule ^assets/imgs/adgm/adgm\-market\-square\.avif$ /assets/images/locations/uae/adgm/adgm-market-square.avif [R=301,L,NE]
RewriteRule ^assets/imgs/ajman\-free\-zone/ajman\-freezone\.jpg$ /assets/images/locations/uae/ajman-free-zone/ajman-freezone.jpg [R=301,L,NE]
RewriteRule ^assets/imgs/business\-setup\-uae/(free\-zone\-jlt\-1800\.webp|free\-zone\-jlt\-960\.webp|offshore\-global\-structuring\-1800\.webp|offshore\-global\-structuring\-960\.webp|uae\-structure\-closing\-generated\.jpg)$ /assets/images/business-setup/uae/$1 [R=301,L,NE]
RewriteRule ^assets/imgs/dafza/(setup\-budget\-planning\-1800\.webp|setup\-budget\-planning\-960\.webp)$ /assets/images/locations/uae/dafza/$1 [R=301,L,NE]
RewriteRule ^assets/imgs/difc/difc\-gate\.webp$ /assets/images/locations/uae/difc/difc-gate.webp [R=301,L,NE]
RewriteRule ^assets/imgs/dubai\-mainland/(business\-documents\-real\.webp|commercial\-architecture\-real\.webp|corporate\-office\-real\.webp|dubai\-business\-skyline\-1800\.webp|dubai\-business\-skyline\-2400\.webp|dubai\-business\-skyline\-960\.webp)$ /assets/images/locations/uae/dubai-mainland/$1 [R=301,L,NE]
RewriteRule ^assets/imgs/favicon/(android\-chrome\-192x192\.png|android\-chrome\-512x512\.png|apple\-touch\-icon\.png|favicon\-16x16\.png|favicon\-32x32\.png|favicon\.ico|site\.webmanifest)$ /assets/icons/favicons/$1 [R=301,L,NE]
RewriteRule ^assets/imgs/jafza/jafza\-business\-district\.jpg$ /assets/images/locations/uae/jafza/jafza-business-district.jpg [R=301,L,NE]
RewriteRule ^assets/imgs/logo/(logo\-alt\.png|logo\.png)$ /assets/images/brand/$1 [R=301,L,NE]
RewriteRule ^assets/imgs/masdar/(masdar\-institute\-pexels\-1600\.webp|masdar\-institute\-pexels\-2400\.webp|masdar\-institute\-pexels\-3840\.webp|masdar\-institute\-pexels\-960\.webp)$ /assets/images/locations/uae/masdar/$1 [R=301,L,NE]
RewriteRule ^assets/imgs/new\-images/optimized/business\-team\-meeting\.jpg$ /assets/images/shared/photography/business-team-meeting.jpg [R=301,L,NE]
RewriteRule ^assets/imgs/new/optimized/ifza\-free\-zone\.webp$ /assets/images/locations/uae/ifza/ifza-free-zone.webp [R=301,L,NE]
RewriteRule ^assets/imgs/rak\-icc/marjan\-island\.webp$ /assets/images/locations/uae/rak-icc/marjan-island.webp [R=301,L,NE]
RewriteRule ^assets/imgs/social/(nikki\-advisory\-og\.jpg|nikki\-advisory\-square\.jpg)$ /assets/images/social/$1 [R=301,L,NE]
RewriteRule ^assets/js/country\-codes\.js$ /assets/js/data/country-codes.js [R=301,L,NE]
RewriteRule ^assets/js/(aos\.js|bootstrap\.bundle\.min\.js|jquery\-3\.7\.1\.js|jquery\.counterup\.min\.js|swiper\.min\.js|waypoints\.min\.js)$ /assets/js/vendor/$1 [R=301,L,NE]
# Browser fallback requests must use the same branded icons as page metadata.
RewriteRule ^favicon\.ico$ assets/icons/favicons/favicon.ico [END]
RewriteRule ^apple-touch-icon(?:-precomposed)?\.png$ assets/icons/favicons/apple-touch-icon.png [END]

# Existing descriptive links are the canonical URLs for these pages.
RewriteCond %{THE_REQUEST} \s/+dafza(?:\.html)?(?:[?\s/]) [NC]
RewriteRule ^dafza(?:\.html)?/?$ /dafza-company-formation [R=301,L,NE,NC]
RewriteCond %{THE_REQUEST} \s/+dmcc(?:\.html)?(?:[?\s/]) [NC]
RewriteRule ^dmcc(?:\.html)?/?$ /dmcc-company-formation [R=301,L,NE,NC]
RewriteCond %{THE_REQUEST} \s/+dubai-silicon-oasis(?:\.html)?(?:[?\s/]) [NC]
RewriteRule ^dubai-silicon-oasis(?:\.html)?/?$ /dubai-silicon-oasis-company-formation [R=301,L,NE,NC]
RewriteCond %{THE_REQUEST} \s/+dubai-south(?:\.html)?(?:[?\s/]) [NC]
RewriteRule ^dubai-south(?:\.html)?/?$ /dubai-south-company-formation [R=301,L,NE,NC]
RewriteCond %{THE_REQUEST} \s/+shams(?:\.html)?(?:[?\s/]) [NC]
RewriteRule ^shams(?:\.html)?/?$ /shams-company-formation [R=301,L,NE,NC]
RewriteRule ^kizad(?:\.html)?/?$ /kezad-company-formation [R=301,L,NE,NC]

# Service pages now use root-level URLs; retain redirects from the old folders.
RewriteRule ^services/(?:index\.html)?$ /services [R=301,L,NE]
RewriteRule ^services/(accounting-bookkeeping|business-structuring|business-support|company-liquidation|corporate-compliance)(?:/index\.html|\.html|/)?$ /$1 [R=301,L,NE]
RewriteRule ^services/(?:pro-services|pro-government-services)(?:/index\.html|\.html|/)?$ /pro-government-services [R=301,L,NE]
RewriteRule ^pro-services(?:\.html)?/?$ /pro-government-services [R=301,L,NE]
RewriteRule ^(accounting-bookkeeping|business-structuring|business-support|company-liquidation|corporate-compliance|pro-government-services)/$ /$1 [R=301,L,NE]

# Preserve old article paths and let the error document keep its 404 status.
RewriteRule ^blogs/([^/]+?)(?:\.html)?/?$ /blog/$1 [R=301,L,NE]
RewriteRule ^blog/?$ /blogs [R=301,L,NE]
RewriteRule ^404\.html$ - [L]

# Canonical home and directory URLs.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

# Direct .html requests redirect once; internal rewrites do not redirect.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Every public page uses the extensionless, slashless URL in its canonical tag.
RewriteRule ^(dafza-company-formation|dmcc-company-formation|dubai-silicon-oasis-company-formation|dubai-south-company-formation|shams-company-formation)/$ /$1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# Resolve descriptive aliases to their static source files.
RewriteRule ^dafza-company-formation/?$ dafza.html [L,NC]
RewriteRule ^dmcc-company-formation/?$ dmcc.html [L,NC]
RewriteRule ^dubai-silicon-oasis-company-formation/?$ dubai-silicon-oasis.html [L,NC]
RewriteRule ^dubai-south-company-formation/?$ dubai-south.html [L,NC]
RewriteRule ^shams-company-formation/?$ shams.html [L,NC]

# Serve extensionless static pages. Missing paths retain a true 404 status.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [END]
